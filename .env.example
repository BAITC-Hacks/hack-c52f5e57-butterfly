# Runtime only. No cloud AI fallback; the separate Brev session supplies endpoints.
BUTTERFLY_DATA_DIR=data/runtime
BUTTERFLY_CORS_ORIGINS=
BUTTERFLY_SECURE_COOKIE=false
BUTTERFLY_COOKIE_SAMESITE=lax
BUTTERFLY_EXPORT_PYTHON=.venv/bin/python
# Path to an existing HackAlem checkout with bin/hackalem-mcp and bin/hackalem-demo-api.
HACKALEM_HOME=
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
NEMOTRON_API_KEY=
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=
# Existing Brev runtime: addresses below must point to services reachable from this backend.
RIVA_ASR_ENDPOINT=
RIVA_PYTHON=python3
ASR_LANGUAGE=ru-RU
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
BUTTERFLY_PUBLIC_URL=http://127.0.0.1:8000
